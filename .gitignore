# Rust build artifacts (regenerated by cargo; large)
native/target/
native/gl_engine/target/
proxy/target/
preview-host/target/
Cargo.lock

# Local, user-supplied custom-intro media — not part of the source
intro_full.bin
intro_song.ogg

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Runtime assets / build outputs — shipped in the release zip, not source
native/*.dll
native/heaven-icons/
native/README.md

# Local release bundles (zips + loose DLL assets for a GitHub release)
release-v*/

# Machine-local dev helpers (absolute paths) / stale archives
deploy-on-exit.ps1
*.rar

# Throwaway reverse-engineering scratch scripts (proxy debugging)
proxy/_*.py

# Internal architecture docs + session handoff notes — local only, never published
docs-internal/
session-context.json
Deploy-Trackside.ps1

# SECRET — the fine-grained PAT baked into private-channel builds so they can read the
# private releases repo. Never commit this; a public build must never see it either
# (Release-Trackside.ps1 aborts if TRACKSIDE_UPDATE_TOKEN is set in the shell).
# The private release SCRIPT is deliberately not ignored: it lives on trackside-private,
# which is never pushed, and merges only ever run main -> private.
.trackside-update-token.txt

# written next to the test binary by settings::tests (save_current persists off-thread)
native/trackside-settings.json
